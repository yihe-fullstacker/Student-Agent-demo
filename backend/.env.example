# Smart Student Success Agent - Environment Variables

PORT=8000
ENV=development

# Database connection (SQLite by default for local dev; MySQL 8.0 example below)
DATABASE_URL=sqlite:///./data/kaoyan_agent.db
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/kaoyan_agent?charset=utf8mb4

# JWT authentication
JWT_SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting & background scheduler
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_SCHEDULER=true

# Domestic LLM provider (any OpenAI-compatible endpoint works)
# DeepSeek example:
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Other domestic providers (uncomment and adjust):
# 通义千问   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   AI_MODEL=qwen-plus
# 智谱 GLM   AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4                AI_MODEL=glm-4-flash
# Kimi       AI_BASE_URL=https://api.moonshot.cn/v1                          AI_MODEL=moonshot-v1-8k
# 硅基流动   AI_BASE_URL=https://api.siliconflow.cn/v1                       AI_MODEL=deepseek-ai/DeepSeek-V3

# Legacy DEEPSEEK_* variable names are also accepted:
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Set to true only if you want built-in demo data when the provider fails.
ALLOW_DEMO_FALLBACK=false
