# Smart Student Success Agent - Environment Variables

PORT=8000
ENV=development

# Domestic LLM provider (any OpenAI-compatible endpoint works)
# DeepSeek example:
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Other domestic providers (uncomment and adjust):
# 通义千问   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   AI_MODEL=qwen-plus
# 智谱 GLM   AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4                AI_MODEL=glm-4-flash
# Kimi       AI_BASE_URL=https://api.moonshot.cn/v1                          AI_MODEL=moonshot-v1-8k
# 硅基流动   AI_BASE_URL=https://api.siliconflow.cn/v1                       AI_MODEL=deepseek-ai/DeepSeek-V3

# Legacy DEEPSEEK_* variable names are also accepted:
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Set to true only if you want built-in demo data when the provider fails.
ALLOW_DEMO_FALLBACK=false
